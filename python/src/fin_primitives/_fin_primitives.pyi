"""Type stubs for the native extension module (built from src/python in the Rust crate)."""
from decimal import Decimal
from typing import Any, Dict, Iterable, List, Optional, Tuple, Union

_Number = Union[str, int, float, Decimal]

__version__: str

def catalogue() -> List[Dict[str, Any]]: ...
def aliases() -> Dict[str, str]: ...
def resolve(kind: str) -> str: ...

class _Indicator:
    def __init__(self, kind: str, *params: Any) -> None: ...
    @property
    def key(self) -> str: ...
    @property
    def type_name(self) -> str: ...
    @property
    def name(self) -> str: ...
    @property
    def period(self) -> int: ...
    @property
    def is_ready(self) -> bool: ...
    def reset(self) -> None: ...
    def update(self, close: _Number) -> Optional[Decimal]: ...
    def update_bar(
        self,
        close: _Number,
        high: Optional[_Number] = None,
        low: Optional[_Number] = None,
        open: Optional[_Number] = None,
        volume: Optional[_Number] = None,
    ) -> Optional[Decimal]: ...
    def update_f64(self, close: float) -> Optional[float]: ...
    def update_bar_f64(
        self,
        close: float,
        high: Optional[float] = None,
        low: Optional[float] = None,
        open: Optional[float] = None,
        volume: Optional[float] = None,
    ) -> Optional[float]: ...
    def batch(
        self,
        close: Iterable[_Number],
        high: Optional[Iterable[_Number]] = None,
        low: Optional[Iterable[_Number]] = None,
        open: Optional[Iterable[_Number]] = None,
        volume: Optional[Iterable[_Number]] = None,
    ) -> List[Optional[Decimal]]: ...
    def batch_f64(
        self,
        close: bytes,
        high: Optional[bytes] = None,
        low: Optional[bytes] = None,
        open: Optional[bytes] = None,
        volume: Optional[bytes] = None,
    ) -> bytes: ...

